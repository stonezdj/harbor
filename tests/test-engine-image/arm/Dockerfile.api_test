# Build from tests/test-engine-image/arm (do not prepend Dockerfile.common):
# docker build --platform linux/arm64 -f Dockerfile.api_test -t harbor-e2e-engine:latest-api-arm .
FROM golang:1.27.3 AS tool_builder
ARG TARGETARCH=arm64
WORKDIR /tool

RUN test "$TARGETARCH" = arm64 && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git make skopeo && \
    rm -rf /var/lib/apt/lists/* && mkdir -p /tool/binary

RUN CONTAINERD_VERSION=1.7.20 && \
    curl -k -fL "https://github.com/containerd/containerd/releases/download/v${CONTAINERD_VERSION}/containerd-${CONTAINERD_VERSION}-linux-arm64.tar.gz" -o containerd.tar.gz && \
    tar -xzf containerd.tar.gz && cp bin/containerd bin/ctr /tool/binary/ && \
    curl -k -fL https://github.com/docker/compose/releases/download/v2.29.1/docker-compose-linux-aarch64 -o /tool/binary/docker-compose && \
    HELM_VERSION=3.15.3 && \
    curl -k -fL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-arm64.tar.gz" -o helm.tar.gz && \
    tar -xzf helm.tar.gz && mv linux-arm64/helm /tool/binary/ && \
    ORAS_VERSION=1.2.0 && \
    curl -k -fL "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_arm64.tar.gz" -o oras.tar.gz && \
    tar -xzf oras.tar.gz -C /tool/binary oras && \
    IMGPKG_VERSION=0.43.0 && \
    curl -k -fL "https://github.com/vmware-tanzu/carvel-imgpkg/releases/download/v${IMGPKG_VERSION}/imgpkg-linux-arm64" -o /tool/binary/imgpkg && \
    COSIGN_VERSION=2.4.0 && \
    curl -k -fL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-arm64" -o /tool/binary/cosign && \
    NOTATION_VERSION=1.1.1 && \
    curl -k -fL "https://github.com/notaryproject/notation/releases/download/v${NOTATION_VERSION}/notation_${NOTATION_VERSION}_linux_arm64.tar.gz" -o notation.tar.gz && \
    tar -xzf notation.tar.gz -C /tool/binary notation && \
    DIND_COMMIT=3b5fac462d21ca164b3778647420016315289034 && \
    curl -k -fL "https://raw.githubusercontent.com/docker/docker/${DIND_COMMIT}/hack/dind" -o /tool/binary/dind && \
    chmod +x /tool/binary/*

# These releases do not publish ARM64 binaries. Build static binaries for Photon.
RUN git -c http.sslVerify=false clone --depth 1 --branch v0.4.0 https://github.com/cnabio/cnab-to-oci.git && \
    cd cnab-to-oci && CGO_ENABLED=0 make build && \
    cp bin/cnab-to-oci /tool/binary/

RUN git -c http.sslVerify=false clone --depth 1 --branch v0.1.2 https://github.com/engineerd/wasm-to-oci.git && \
    cd wasm-to-oci && CGO_ENABLED=0 make build && \
    cp bin/wasm-to-oci /tool/binary/

RUN chmod +x /tool/binary/* && \
    strip -s /tool/binary/* 2>/dev/null || true && \
    tar -czf /tool/tools.tar.gz -C /tool/binary .

# Download and strip static Docker binaries
RUN DOCKER_VERSION=20.10.3 && \
    curl -k -fL "https://download.docker.com/linux/static/stable/aarch64/docker-${DOCKER_VERSION}.tgz" -o docker.tgz && \
    mkdir -p /tool/docker && \
    tar --strip-components=1 -xzf docker.tgz -C /tool/docker && \
    strip -s /tool/docker/* 2>/dev/null || true && \
    chmod +x /tool/docker/* && \
    rm docker.tgz

# The checked-in busybox.tar contains an AMD64 image.
RUN skopeo --override-os linux --override-arch arm64 copy \
    docker://docker.io/library/busybox:1.37.0 \
    docker-archive:/tool/busybox.tar:busybox:latest

# Photon provides a native ARM64 base image.
FROM photon:4.0
ARG PIP_INDEX_URL
ENV LANG=C.UTF-8
ENV HELM_EXPERIMENTAL_OCI=1
ENV COSIGN_PASSWORD=Harbor12345
ENV COSIGN_EXPERIMENTAL=1
ENV COSIGN_OCI_EXPERIMENTAL=1
ENV NOTATION_EXPERIMENTAL=1

RUN tdnf update -y && tdnf install -y \
    wget \
    git \
    openjre8 \
    iproute2 \
    iptables \
    podman \
    build-essential \
    sed \
    openssl-devel \
    libffi-devel \
    python3-devel \
    nss \
    tar \
    which \
    procps-ng \
    gzip && \
    tdnf erase -y toybox && \
    tdnf install -y python3 python3-pip python3-setuptools && \
    if [ -n "$PIP_INDEX_URL" ]; then \
        pip3 config set global.index-url "$PIP_INDEX_URL"; \
    elif curl -s --connect-timeout 2 -k https://packages.vcfd.broadcom.net >/dev/null 2>&1; then \
        pip3 config set global.index-url "https://packages.vcfd.broadcom.net/artifactory/api/pypi/pypi-virtual/simple"; \
    fi && \
    pip3 install --no-cache-dir --upgrade pip pyasn1 python-dateutil \
    robotframework==6.0.1 robotframework-sshlibrary robotframework-httplibrary \
    requests dbbot robotframework-seleniumlibrary robotframework-pabot \
    robotframework-JSONLibrary hurry.filesize --upgrade && \
    tdnf erase -y build-essential gcc binutils python3-devel openssl-devel libffi-devel libstdc++-devel glibc-devel linux-api-headers && \
    tdnf clean all && \
    rm -rf /root/.cache /var/cache/tdnf /usr/share/man /usr/share/doc

COPY --from=tool_builder /tool/docker/ /usr/bin/
COPY --from=tool_builder /tool/tools.tar.gz /usr/local/bin/
COPY containerd_config.toml /etc/containerd/config.toml
COPY --from=tool_builder /tool/busybox.tar /
# This container needs to be run in privileged mode(run with --privileged option) to make it work
COPY dockerd-entrypoint.sh /usr/local/bin/dockerd-entrypoint.sh

RUN chmod +x /usr/local/bin/dockerd-entrypoint.sh && \
    mkdir -p $HOME/.pki/nssdb /usr/local/share/ca-certificates/ && \
    echo Harbor12345 > password.ca && \
    certutil -d sql:$HOME/.pki/nssdb -N -f password.ca

VOLUME /var/lib/docker
